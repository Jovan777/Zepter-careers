# Reference only.
# Docker Compose deployment uses the root `.env` file next to docker-compose.yml.
# Prefer editing root `.env.docker.example` / root `.env` instead of this file.

NODE_ENV=production
PORT=5000
MONGO_URI=mongodb://mongo:27017/zepter-careers

JWT_SECRET=replace-with-a-strong-secret
CONTACT_SECURITY_SECRET=replace-with-a-strong-contact-security-secret
APP_BASE_URL=http://localhost:11001

MAIL_FROM_EMAIL=karijera@zepter.rs
MAIL_FROM_NAME=Zepter Careers

MAILTRAP_API_TOKEN=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_IGNORE_TLS=false
SMTP_REQUIRE_TLS=false
SMTP_AUTH=true
SMTP_TLS_MIN_VERSION=
