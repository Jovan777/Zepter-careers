# Local backend development only.
# Docker deployment does not read this file.
# For Docker, copy the root `.env.docker.example` to root `.env`.

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/zepter-careers
JWT_SECRET=change-me-for-local-development
JWT_EXPIRES_IN=7d
CONTACT_SECURITY_SECRET=change-me-contact-security-local

APP_BASE_URL=http://localhost:5173

MAIL_FROM_EMAIL=karijera@zepter.rs
MAIL_FROM_NAME=Zepter Careers

MAILTRAP_API_TOKEN=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_IGNORE_TLS=false
SMTP_REQUIRE_TLS=false
SMTP_AUTH=true
SMTP_TLS_MIN_VERSION=
