# Zepter Careers Docker deployment environment
#
# Docker Compose reads variables from the root `.env` file next to
# docker-compose.yml. For deployment, copy this file to `.env` and edit that
# root `.env` file only.
#
# PowerShell:
# Copy-Item .env.docker.example .env
#
# Linux/macOS:
# cp .env.docker.example .env

# Host bindings. Defaults keep services private to the server.
FRONTEND_BIND_HOST=127.0.0.1
FRONTEND_PORT=11001

BACKEND_BIND_HOST=127.0.0.1
BACKEND_PORT=11002

# Host folder for uploaded files.
# If set, Docker mounts this folder to /app/uploads inside the backend container.
# This covers all uploaded documents, not only CV files.
# Current production path:
UPLOADS_HOST_PATH=/home/promozepter/.local/share/Zepter-Careers

# Public folder where the frontend is mounted.
# For https://promo.zepter.rs/posao/, use /posao/.
# If the app is served from the domain root, use /.
# Do not leave this empty for production deep-route deployments:
# relative assets are fragile for direct URLs such as
# /posao/secure-zc-panel-8f4k/login.
# Do not hardcode /posao/ in source code; keep this env-configurable.
VITE_PUBLIC_BASE_PATH=/posao/

# Leave empty for Docker.
# The frontend derives /api when served from root and /posao/api when served
# under /posao/.
VITE_API_BASE_URL=

VITE_ADMIN_LOGIN_PATH=/secure-zc-panel-8f4k/login

# Must match the external frontend URL, including subfolder if used.
APP_BASE_URL=https://promo.zepter.rs/posao

# Replace before production deployment.
JWT_SECRET=replace-with-a-strong-secret
CONTACT_SECURITY_SECRET=replace-with-a-strong-contact-security-secret

MAIL_FROM_EMAIL=karijera@zepter.rs
MAIL_FROM_NAME=Zepter Careers

# Mailtrap API fallback, optional.
MAILTRAP_API_TOKEN=

SMTP_HOST=mail2.zepter.rs
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_IGNORE_TLS=true
SMTP_REQUIRE_TLS=false
SMTP_AUTH=false
SMTP_TLS_MIN_VERSION=
# MongoDB is internal to Docker Compose by default.
# Do not expose MongoDB to the host in production unless explicitly needed.
